# DJ_PIN: Required passcode PIN for DJ / Stage Admin console and player.
# No default PIN is provided.
DJ_PIN="1234"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for YouTube search.
# If omitted or quota exceeded, search falls back cleanly to the curated master list.
YOUTUBE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
